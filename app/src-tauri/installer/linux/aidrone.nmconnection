# The host side of the AIdrone USB-NCM link, applied automatically when the
# node is plugged in.
#
# There is no DHCP server on the host's side of this cable - the node is the
# drone's AP, not the laptop's - so without a profile like this the adapter
# comes up with no address and the link looks dead. That manual `ip addr add`
# is the step this file exists to delete.
#
# `never-default` and the absent gateway are load-bearing: a default route here
# would send the machine's internet traffic down a USB cable to a drone.
#
# Installed to /etc/NetworkManager/system-connections/ with mode 0600, which
# NetworkManager requires and silently ignores the file without.
[connection]
id=AIdrone Link
type=ethernet
interface-name=aidrone0
autoconnect=true
autoconnect-priority=10

[ethernet]

[ipv4]
method=manual
address1=192.168.4.50/24
never-default=true
ignore-auto-dns=true
ignore-auto-routes=true

[ipv6]
method=ignore

[proxy]

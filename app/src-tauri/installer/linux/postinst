#!/bin/sh
# Installs the USB bulk-device permission rule without overwriting a locally
# customized rule. The checksum state records the version we last staged.
set -e

RULES_SRC=/usr/lib/aidrone/installer/70-aidrone-usb.rules
RULES_DST=/etc/udev/rules.d/70-aidrone-usb.rules
STATE_DIR=/var/lib/aidrone/installer
RULES_STATE=$STATE_DIR/70-aidrone-usb.rules.sha256

hash_file() {
  sha256sum "$1" | awk '{print $1}'
}

state_matches() {
  state=$1
  dst=$2
  [ -f "$state" ] && [ -f "$dst" ] || return 1
  IFS= read -r expected < "$state"
  [ "$expected" = "$(hash_file "$dst")" ]
}

install_managed() {
  [ -f "$RULES_SRC" ] || { echo "AIdrone: missing packaged USB udev rule: $RULES_SRC" >&2; exit 1; }
  if [ -e "$RULES_DST" ] && ! state_matches "$RULES_STATE" "$RULES_DST"; then
    echo "AIdrone: preserving locally modified USB udev rule: $RULES_DST" >&2
    return 1
  fi

  install -D -o root -g root -m 0644 "$RULES_SRC" "$RULES_DST" ||
    { echo "AIdrone: could not install USB udev rule: $RULES_DST" >&2; exit 1; }
  hash_file "$RULES_DST" > "$RULES_STATE" ||
    { echo "AIdrone: could not record USB udev rule ownership" >&2; exit 1; }
}

case "$1" in
  configure)
    mkdir -p "$STATE_DIR"
    if install_managed; then
      udevadm control --reload-rules 2>/dev/null || true
    fi
    ;;
esac

#DEBHELPER#
exit 0

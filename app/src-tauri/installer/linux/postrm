#!/bin/sh
# Removes only the unmodified USB permission rule on package purge.
set -e

RULES_DST=/etc/udev/rules.d/70-aidrone-usb.rules
STATE_DIR=/var/lib/aidrone/installer
RULES_STATE=$STATE_DIR/70-aidrone-usb.rules.sha256

hash_file() {
  sha256sum "$1" | awk '{print $1}'
}

state_matches() {
  [ -f "$RULES_STATE" ] && [ -f "$RULES_DST" ] || return 1
  IFS= read -r expected < "$RULES_STATE"
  [ "$expected" = "$(hash_file "$RULES_DST")" ]
}

case "$1" in
  purge)
    if [ ! -e "$RULES_DST" ]; then
      rm -f "$RULES_STATE"
    elif state_matches; then
      rm -f "$RULES_DST" "$RULES_STATE"
      udevadm control --reload-rules 2>/dev/null || true
    else
      echo "AIdrone: preserving locally modified USB udev rule on purge: $RULES_DST" >&2
      rm -f "$RULES_STATE"
    fi
    rmdir "$STATE_DIR" 2>/dev/null || true
    ;;
esac
#DEBHELPER#
exit 0
